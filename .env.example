# Copy to .env (never commit .env). At least one model provider key is required.

# ── Models (Mozaik picks the provider from the model name) ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides, comma-separated, first = preferred, rest = fallbacks
# QUORUM_MODELS_FAST=claude-haiku-4-5,gpt-5.4-mini
# QUORUM_MODELS_SMART=claude-sonnet-5-5,gpt-5.5

# ── Tools ────────────────────────────────────────────────────────────────
# Web search for the Fact-Checker (https://tavily.com). Without it the Fact-Checker is disabled.
TAVILY_API_KEY=

# ── Memory (Phase 2) ─────────────────────────────────────────────────────
MEM0_API_KEY=

# ── Mozaik Cloud (live run links for judges) ─────────────────────────────
# Project key from https://app.jigjoy.ai — or run `npx @mozaik-ai/cloud-sdk pair` once.
MOZAIK_API_KEY=
# Redact prompts/memory sent to the cloud (keep on for real meetings)
MOZAIK_REDACTION=true

# ── App (web + rooms) ────────────────────────────────────────────────────
# Local: `pnpm db:local` (embedded Postgres) or `docker compose up -d` — same URL
DATABASE_URL=postgres://quorum:quorum@127.0.0.1:54329/quorum
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Shared by web (mints room tokens) and rooms (verifies them)
ROOMS_JWT_SECRET=
NEXT_PUBLIC_ROOMS_URL=ws://localhost:4000/ws
# Rooms server: comma-separated browser origins allowed in production
# ALLOWED_ORIGINS=https://quorum.example.com

# ── Calls (production) ──────────────────────────────────────────────────
# Managed TURN relay for callers behind strict NATs/firewalls (comma-separated URLs)
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
